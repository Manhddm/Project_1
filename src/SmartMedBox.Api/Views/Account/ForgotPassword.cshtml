@model SmartMedBox.Api.Controllers.AccountForm
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<section class="panel">
    <h1>Quên mật khẩu</h1>
    <p>Nhập email đã đăng ký, chúng tôi sẽ gửi mã đặt lại mật khẩu.</p>
    <form asp-action="ForgotPassword" method="post" novalidate>
        <partial name="_Fields" view-data='new ViewDataDictionary(ViewData) { ["Fields"] = "email" }' />
        <button type="submit">Gửi mã đặt lại</button>
    </form>
    <p>Đã có mã? <a asp-action="ResetPassword">Đặt lại mật khẩu</a></p>
</section>
