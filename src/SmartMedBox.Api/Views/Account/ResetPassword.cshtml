@model SmartMedBox.Api.Controllers.AccountForm
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<section class="panel">
    <h1>Đặt lại mật khẩu</h1>
    <form asp-action="ResetPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
        <partial name="_Fields" view-data='new ViewDataDictionary(ViewData) { ["Fields"] = "token new-password" }' />
        <button type="submit">Đặt lại mật khẩu</button>
    </form>
    <p>Chưa có mã? <a asp-action="ForgotPassword">Yêu cầu mã mới</a></p>
</section>
