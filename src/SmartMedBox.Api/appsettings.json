{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "EmailSink": {
    "DirectoryPath": "App_Data/email-sink"
  }
}
